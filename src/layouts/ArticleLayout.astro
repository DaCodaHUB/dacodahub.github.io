---
import BaseLayout from './BaseLayout.astro';
import { formatArticleDate } from '../lib/writing';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  readingMinutes?: number;
  relatedProject?: { id: string; title: string };
}
const { title, description, publishedAt, updatedAt, tags = [], readingMinutes, relatedProject } = Astro.props;
---
<BaseLayout title={`${title} — Dang Le`} {description} ogType="article">
  <article class="section content-page article-page">
    <div class="container">
      <header class="article-page__header">
        <a class="article-page__back" href="/writing/">← Writing</a>
        <p class="eyebrow">Engineering notes</p>
        <h1>{title}</h1>
        <p class="article-page__dek">{description}</p>
        <div class="article-page__meta">
          <span>Published <time datetime={publishedAt.toISOString()}>{formatArticleDate(publishedAt)}</time></span>
          {updatedAt && <span>Updated <time datetime={updatedAt.toISOString()}>{formatArticleDate(updatedAt)}</time></span>}
          {readingMinutes && <span>{readingMinutes} min read</span>}
        </div>
        {tags.length > 0 && <ul class="tags" aria-label="Article topics">{tags.map((tag) => <li>{tag}</li>)}</ul>}
      </header>
      <div class="content-page__body article-body"><slot /></div>
      <footer class="article-page__footer">
        {relatedProject && <p><a class="text-link" href={`/projects/${relatedProject.id}/`}>Related project: {relatedProject.title} <span aria-hidden="true">→</span></a></p>}
        <nav aria-label="Article navigation">
          <a href="/writing/">← Writing</a>
          <a href="/projects/">Projects / Work →</a>
        </nav>
      </footer>
    </div>
  </article>
</BaseLayout>
