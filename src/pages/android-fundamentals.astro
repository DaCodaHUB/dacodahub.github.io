---
import BaseLayout from '../layouts/BaseLayout.astro';
import AndroidTopicCard from '../components/AndroidTopicCard.astro';
import { topics, categories } from '../data/android-fundamentals/topics';
import '../styles/android-library.css';
const resourceCount = new Set(topics.flatMap(topic => topic.resources.map(resource => resource.url))).size;
---
<BaseLayout title="Android Fundamentals Library — Dang Le" description="A searchable Android engineering reference: Kotlin, coroutines, Compose, architecture, storage, security, testing and mobile system design. Curated documentation, videos, code and articles.">
  <section class="container android-library" aria-labelledby="library-title" data-android-library>
    <header class="android-library-header">
      <p class="eyebrow">Android engineering / Reference library</p>
      <h1 id="library-title">Android fundamentals.<br /><span class="accent">Built for looking things up.</span></h1>
      <p>Find a concept, revisit a trade-off, go straight to the source. An evergreen library for engineers building their first Android app or designing their next system.</p>
      <dl class="android-library-stats"><div><dt>Topics</dt><dd>{topics.length}</dd></div><div><dt>Categories</dt><dd>{categories.length}</dd></div><div><dt>Curated resources</dt><dd>{resourceCount}</dd></div></dl>
    </header>

    <form class="android-search-panel" role="search" aria-label="Search the Android library" data-library-controls hidden>
      <div class="android-search-field"><label for="library-search">What are you looking for?</label><div class="android-search-input"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.5" /></svg><input id="library-search" type="search" name="q" placeholder="Try process death, StateFlow, caching…" autocomplete="off" maxlength="200" aria-describedby="library-search-help" /></div><p id="library-search-help">Search titles, descriptions, key concepts and resource titles.</p></div>
      <div class="android-mobile-category"><label for="library-category">Category</label><select id="library-category" name="category"><option value="all">All categories</option>{categories.map(category => <option value={category.id}>{category.title}</option>)}</select></div>
      <div class="android-level-field"><label for="library-difficulty">Experience level</label><select id="library-difficulty" name="difficulty"><option value="all">All levels</option><option>Beginner</option><option>Intermediate</option><option>Advanced</option></select></div>
    </form>

    <div class="android-directory-layout">
      <aside class="android-categories" aria-labelledby="categories-title" data-library-controls hidden>
        <h2 id="categories-title">Browse categories</h2>
        <div role="group" aria-label="Filter topics by category"><button type="button" data-category-filter="all" aria-pressed="true"><span>All topics</span><span>{topics.length}</span></button>{categories.map(category => <button type="button" data-category-filter={category.id} aria-pressed="false"><span>{category.title}</span><span>{topics.filter(topic => topic.category === category.id).length}</span></button>)}</div>
        <p>Explore at your own depth. Level labels describe the topic’s complexity, not a required order.</p>
      </aside>
      <div class="android-results">
        <fieldset class="android-resource-filters" data-library-controls hidden>
          <legend>Resource type</legend>
          {[['all', 'All'], ['documentation', 'Documentation'], ['video', 'Videos'], ['repository', 'GitHub'], ['article', 'Articles']].map(([value, label]) => <label><input type="radio" name="resource-type" value={value} checked={value === 'all'} /><span>{label}</span></label>)}
        </fieldset>
        <div class="android-results-heading"><h2>Explore the library</h2><p id="library-results-count" role="status" aria-live="polite" aria-atomic="true">{topics.length} topics</p></div>
        <div class="android-active-filters" data-filter-summary hidden><p data-filter-description></p><button type="button" data-reset-filters>Clear filters</button></div>
        <noscript><p class="android-noscript">All topics are shown below. Use your browser’s Find command to search and open a topic’s resources to read more.</p></noscript>
        <div class="android-topic-grid" id="library-results">{topics.map(topic => <AndroidTopicCard {topic} categoryTitle={categories.find(category => category.id === topic.category)!.title} />)}</div>
        <div class="android-empty" data-library-empty hidden><p class="eyebrow">No matches</p><h3>No topics found</h3><p>Try a broader search, another category a different resource type or experience level.</p><button type="button" class="btn btn--primary" data-reset-filters>Reset search &amp; filters</button></div>
      </div>
    </div>
    <footer class="android-library-notes"><h2>A note on the collection</h2><p>Official Android and Kotlin documentation comes first. Repositories and engineering articles show concrete approaches; they are not universal prescriptions. Older videos are labeled and should be paired with current documentation. External links open in a new tab.</p><p>Platform behavior changes with Android releases and target SDK levels. Check the current source before applying guidance to production. Resource review details and maintenance instructions are recorded in the repository.</p><div><a href="https://developer.android.com/" target="_blank" rel="noopener noreferrer" aria-label="Android Developers (opens in a new tab)">Android Developers ↗</a><a href="https://kotlinlang.org/docs/home.html" target="_blank" rel="noopener noreferrer" aria-label="Kotlin documentation (opens in a new tab)">Kotlin documentation ↗</a></div></footer>
  </section>
</BaseLayout>

<script>
  import { filterTopics, countResources } from '../lib/android-library';
  import type { TopicIndex, LibraryFilters } from '../lib/android-library';
  import type { Difficulty, ResourceType } from '../data/android-fundamentals/types';
  const library = document.querySelector<HTMLElement>('[data-android-library]');
  if (library) {
    library.dataset.enhanced = 'true';
    const search = library.querySelector<HTMLInputElement>('#library-search')!;
    const category = library.querySelector<HTMLSelectElement>('#library-category')!;
    const difficulty = library.querySelector<HTMLSelectElement>('#library-difficulty')!;
    const resourceControls = [...library.querySelectorAll<HTMLInputElement>('input[name="resource-type"]')];
    const selectedType = () => resourceControls.find(control => control.checked)!.value;
    const cards = [...library.querySelectorAll<HTMLElement>('[data-library-topic]')];
    const index: TopicIndex[] = cards.map(card => ({ id: card.id, category: card.dataset.category!, difficulty: card.dataset.difficulty as Difficulty, text: card.dataset.search!, resources: [...card.querySelectorAll<HTMLAnchorElement>('[data-resource-link]')].map(link => ({ url: link.href, type: link.dataset.resourceType as ResourceType })) }));
    const buttons = [...library.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
    const count = library.querySelector('#library-results-count')!;
    const empty = library.querySelector<HTMLElement>('[data-library-empty]')!;
    const summary = library.querySelector<HTMLElement>('[data-filter-summary]')!;
    function update(saveUrl = true) {
      const filters: LibraryFilters = { query: search.value, category: category.value, difficulty: difficulty.value, resourceType: selectedType() };
      const matchedTopics = filterTopics(index, filters);
      const matches = new Set(matchedTopics.map(topic => topic.id));
      cards.forEach((card, i) => {
        card.hidden = !matches.has(card.id);
        if (card.hidden) card.querySelector('details')!.open = false;
        card.querySelectorAll<HTMLElement>('[data-resource-group]').forEach(group => { group.hidden = selectedType() !== 'all' && group.dataset.resourceGroup !== selectedType(); });
        const total = index[i]!.resources.length;
        const shown = index[i]!.resources.filter(resource => selectedType() === 'all' || resource.type === selectedType()).length;
        card.querySelector('[data-resource-count]')!.textContent = selectedType() === 'all' ? total + ' links' : shown + ' of ' + total + ' links';
      });
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.categoryFilter === category.value)));
      count.textContent = `${matches.size} ${matches.size === 1 ? 'topic' : 'topics'}${matches.size === topicsCount ? '' : ` of ${topicsCount}`}`;
      count.textContent += ` \u00b7 ${countResources(matchedTopics, selectedType())} unique resources shown`;
      empty.hidden = matches.size > 0;
      summary.hidden = !search.value.trim() && category.value === 'all' && difficulty.value === 'all' && selectedType() === 'all';
      library!.querySelector('[data-filter-description]')!.textContent = [search.value.trim() ? `Search: “${search.value.trim()}”` : '', category.value !== 'all' ? category.selectedOptions[0]!.textContent : '', difficulty.value !== 'all' ? difficulty.value : '', selectedType() !== 'all' ? resourceControls.find(control => control.checked)!.nextElementSibling!.textContent : ''].filter(Boolean).join(' · ');
      if (saveUrl) {
        const url = new URL(location.href);
        for (const [key, value] of Object.entries({ q: search.value.trim(), category: category.value === 'all' ? '' : category.value, difficulty: difficulty.value === 'all' ? '' : difficulty.value, type: selectedType() === 'all' ? '' : selectedType() })) value ? url.searchParams.set(key, value) : url.searchParams.delete(key);
        history.replaceState(null, '', url);
      }
    }
    const topicsCount = cards.length;
    function reset() { search.value = ''; category.value = 'all'; difficulty.value = 'all'; resourceControls.forEach(control => { control.checked = control.value === 'all'; }); update(); }
    const params = new URLSearchParams(location.search);
    const requestedType = resourceControls.find(control => control.value === params.get('type'));
    if (requestedType) requestedType.checked = true;
    resourceControls.forEach(control => control.addEventListener('change', () => update()));
    search.value = (params.get('q') ?? '').slice(0, 200);
    if ([...category.options].some(option => option.value === params.get('category'))) category.value = params.get('category')!;
    if ([...difficulty.options].some(option => option.value === params.get('difficulty'))) difficulty.value = params.get('difficulty')!;
    library.querySelectorAll<HTMLElement>('[data-library-controls]').forEach(control => { control.hidden = false; });
    search.addEventListener('input', () => update()); category.addEventListener('change', () => update()); difficulty.addEventListener('change', () => update());
    library.querySelector('form')!.addEventListener('submit', event => { event.preventDefault(); update(); });
    buttons.forEach(button => button.addEventListener('click', () => { category.value = button.dataset.categoryFilter!; update(); }));
    library.querySelectorAll('[data-reset-filters]').forEach(button => button.addEventListener('click', () => { reset(); search.focus(); }));
    function revealTopic(id: string, focus = true) {
      const card = cards.find(card => card.id === id); if (!card) return;
      if (card.hidden) reset();
      card.querySelector('details')!.open = true;
      if (focus) { card.focus({ preventScroll: true }); card.scrollIntoView({ block: 'start' }); }
    }
    library.querySelectorAll<HTMLAnchorElement>('[data-topic-link]').forEach(link => link.addEventListener('click', () => { revealTopic(link.hash.slice(1), false); }));
    window.addEventListener('hashchange', () => revealTopic(location.hash.slice(1)));
    update(false);
    if (location.hash) revealTopic(location.hash.slice(1));
  }
</script>
