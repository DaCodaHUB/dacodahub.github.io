---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.caseStudy);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { Content } = await render(project);
---
<ProjectLayout
  title={project.data.title}
  description={project.data.description}
  technologies={project.data.technologies}
  githubUrl={project.data.githubUrl}
  demoUrl={project.data.demoUrl}
>
  <Content />
</ProjectLayout>
