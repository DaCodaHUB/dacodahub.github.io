---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getPublishedArticles } from '../lib/writing';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.find((entry) => entry.data.featured);
if (!featured) throw new Error('Featured project is missing');
const selectedIds = ['dripcheck', 'simplepiano', 'blade-gamblers'];
const moreIds = ['imu-mouse', 'heart-monitor'];
const selectedProjects = selectedIds.map((id) => projects.find((entry) => entry.id === id));
const moreProjects = moreIds.map((id) => projects.find((entry) => entry.id === id));
const recentArticles = (await getPublishedArticles()).slice(0, 3);
if ([...selectedProjects, ...moreProjects].some((entry) => !entry)) throw new Error('A homepage project is missing');
---
<BaseLayout
  title="Dang Le — Software Engineer | Android & Mobile"
  description="Software engineer specializing in Android and cross-platform mobile development. 8 years of experience in technical design, API integration, and production delivery for apps serving 700K+ combined users."
  ogDescription="Android and React Native engineering, application architecture, and production ownership for reliable mobile software."
  home
>
      <section class="hero">
        <div class="container hero__grid">
          <div class="hero__copy">
            <p class="eyebrow"><span class="status-dot"></span> Software engineer · Android & mobile · Vancouver, WA</p>
            <h1>Building <span class="accent">reliable, high-performance software.</span></h1>
            <p class="hero__intro">
              I specialize in native Android and React Native, adapting across
              native, cross-platform, and web-integrated technologies. I bring
              technical design and application architecture through feature delivery,
              API integration, production troubleshooting, and releases.
            </p>

            <div class="buttons">
              <a class="btn btn--primary" href="#work">View engineering work <span aria-hidden="true">↓</span></a>
              <a class="btn" href="/assets/resume.pdf" target="_blank" rel="noreferrer">
                View résumé <span aria-hidden="true">↗</span>
              </a>
            </div>

            <div class="proof" aria-label="Professional highlights">
              <div><strong>8</strong><span>Years of professional experience</span></div>
              <div><strong>700K+</strong><span>Combined application users</span></div>
              <div><strong>99.82%</strong><span>USCC Call Guardian crash-free performance</span></div>
            </div>
          </div>

          <aside class="terminal-card" aria-label="Engineering profile">
            <div class="terminal-card__bar">
              <span></span><span></span><span></span>
              <p>engineering-profile.kt</p>
            </div>
            <div class="terminal-card__body">
              <p><span class="code-purple">val</span> engineer = <span class="code-blue">Engineer</span>(</p>
              <p class="indent">name = <span class="code-green">"Dang Le"</span>,</p>
              <p class="indent">craft = <span class="code-green">"Android & mobile"</span>,</p>
              <p class="indent">toolkit = listOf(</p>
              <p class="indent-2"><span class="code-green">"Kotlin"</span>, <span class="code-green">"Compose"</span>,</p>
              <p class="indent-2"><span class="code-green">"Architecture"</span>, <span class="code-green">"React Native"</span></p>
              <p class="indent">),</p>
              <p class="indent">priorities = listOf(</p>
              <p class="indent-2"><span class="code-green">"reliability"</span>, <span class="code-green">"clarity"</span>,</p>
              <p class="indent-2"><span class="code-green">"user impact"</span></p>
              <p class="indent">)</p>
              <p>)</p>
            </div>
          </aside>
        </div>
      </section>

      <section id="impact" class="section section--tinted impact-section" aria-labelledby="impact-title">
        <div class="container">
          <div class="section-heading impact-heading">
            <div>
              <p class="eyebrow">01 / Production impact</p>
              <h2 id="impact-title">Built and kept running in production.</h2>
            </div>
            <p>Production Android experience across USCC Call Guardian and Xfinity Call Guard, serving 700K+ users combined.</p>
          </div>
          <div class="impact-grid">
            <article class="impact-card">
              <span class="impact-card__number">01</span>
              <h3>Production scale</h3>
              <p>Professional Android engineering across USCC Call Guardian (500K+ users) and Xfinity Call Guard (200K+ users).</p>
            </article>
            <article class="impact-card">
              <span class="impact-card__number">02</span>
              <h3>Reliability</h3>
              <p>Resolved serious background synchronization defects and helped maintain 99.82% crash-free performance for USCC Call Guardian, reported by Firebase Crashlytics.</p>
            </article>
            <article class="impact-card">
              <span class="impact-card__number">03</span>
              <h3>Production troubleshooting</h3>
              <p>Diagnosed a Firebase issue associated with backend costs tripling and delivered a hotfix within one week.</p>
            </article>
            <article class="impact-card">
              <span class="impact-card__number">04</span>
              <h3>Technical ownership</h3>
              <p>Led substantial Android development for USCC Call Guardian and later became the sole Android maintainer for Xfinity Call Guard, owning ongoing development, fixes, and releases.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="work" class="section">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">02 / Featured work</p>
              <h2>Working through unreliable connectivity.</h2>
            </div>
            <p>
              How can users keep working without a connection while their changes
              synchronize safely later? JobTracker explores that problem in Android.
            </p>
          </div>

          <article class="project">
            <div class="project__content">
              <div class="project__meta">
                <span>{featured.data.category}</span>
                <span>Android</span>
              </div>
              <h3>{featured.data.title}</h3>
              <p class="project__lead">{featured.data.lead}</p>

              <div class="project__details">
                {featured.data.highlights?.map((highlight, index) => (
                  <div>
                    <span class="detail-number">{String(index + 1).padStart(2, '0')}</span>
                    <div><strong>{highlight.title}</strong><p>{highlight.description}</p></div>
                  </div>
                ))}
              </div>

              <ul class="tags" aria-label="Technologies used">
                {featured.data.technologies.map((technology) => <li>{technology}</li>)}
              </ul>

              <div class="project__actions">
                <a class="text-link" href={`/projects/${featured.id}/`}>View engineering case study <span aria-hidden="true">→</span></a>
                <a class="text-link" href={featured.data.githubUrl} target="_blank" rel="noopener noreferrer">View source on GitHub <span aria-hidden="true">↗</span></a>
              </div>
            </div>

            <div class="project__visual" aria-label="JobTracker app screenshots">
              {featured.data.images?.map((shot, index) => (
                <figure class={`phone-shot ${index === 0 ? 'phone-shot--dashboard' : 'phone-shot--detail'}`}>
                  <img src={shot.src} alt={shot.alt} loading="lazy" decoding="async" />
                  <figcaption>{shot.caption}</figcaption>
                </figure>
              ))}
            </div>
          </article>
        </div>
      </section>

      <section id="selected-projects" class="section selected-projects" aria-labelledby="selected-projects-title">
        <div class="container">
            <div class="other-projects__heading">
              <p class="eyebrow">03 / Selected projects</p>
              <h2 id="selected-projects-title">Selected Projects</h2>
              <p>Mobile interactions, device capabilities, and collaborative development.</p>
            </div>
            <div class="other-projects__grid selected-projects__grid">
              {selectedProjects.map((entry) => entry && <ProjectCard project={entry} />)}
            </div>

          <section class="more-projects" aria-labelledby="more-projects-title">
            <div class="more-projects__heading">
              <h3 id="more-projects-title">More Projects</h3>
              <p>Embedded systems and hardware explorations.</p>
            </div>
            <div class="other-projects__grid">
              {moreProjects.map((entry) => entry && <ProjectCard project={entry} />)}
            </div>
          </section>
        </div>
      </section>

      <section id="experience" class="section section--tinted">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">04 / Experience</p>
              <h2>Proven in production.</h2>
            </div>
            <p>Eight years delivering mobile products—from Samsung retail experiences to consumer Android applications used at scale.</p>
          </div>

          <div class="timeline">
            <article class="timeline__item">
              <div class="timeline__when">June 2021 – August 2026</div>
              <div>
                <p class="role-meta">Transaction Network Services – Remote (Seattle, WA)</p>
                <h3>Android Engineer</h3>
                <p class="role-summary">
                  Primary Android engineer for USCC Call Guardian (500K+ users).
                  Contributed to Xfinity Call Guard (200K+ users) during initial development
                  on the company's shared framework, later becoming its sole Android maintainer.
                </p>
                <p class="role-summary">
                  Xfinity Call Guard · <a class="text-link" href="https://play.google.com/store/apps/details?id=com.xfinity.mobile.spamfilter&amp;hl=en_US" target="_blank" rel="noopener noreferrer" aria-label="View on Google Play: Xfinity Call Guard (opens in a new tab)">View on Google Play <span aria-hidden="true">→</span></a>
                </p>
                <ul class="impact-list">
                  <li><strong>USCC Call Guardian:</strong> Developed a Java / Android SDK application with XML and WebView interfaces using HTML, CSS, and JavaScript. Implemented Google Sign-In and Firebase settings synchronization, collaborating with an iOS developer on a shared JSON format while preserving local access to preferences.</li>
                  <li>Simplified USCC authorization with server verification of SIM-associated phone numbers and multi-SIM support. Delivered neighborhood spoof protection, web-to-app deep linking, and improvements to onboarding, subscriptions, and large-font accessibility.</li>
                  <li>Updated Android platform compatibility and resolved production synchronization defects. Helped maintain USCC's 99.82% crash-free performance in Firebase Crashlytics; diagnosed a Firebase defect associated with backend costs tripling and delivered a hotfix within one week.</li>
                  <li><strong>Xfinity Call Guard:</strong> Built text-spam functionality, in-app feedback, tooltips, and UI components in React Native with native Android integrations using Kotlin. Worked with React Context API, coroutines, WorkManager, and the legacy React Native bridge.</li>
                  <li><strong>Delivery:</strong> Owned technical design, implementation, code reviews, and production releases, working with product, design, QA, and backend colleagues. Supported established build and release processes using Jenkins, GitLab CI/CD, Gradle, and Digital.ai workflows.</li>
                </ul>
              </div>
            </article>
            <article class="timeline__item">
              <div class="timeline__when">July 2018 – May 2021</div>
              <div>
                <p class="role-meta">TecAce Software – Hybrid (Bellevue, WA)</p>
                <h3>Android Engineer</h3>
                <p class="role-summary">
                  Developed Android and React Native applications for Samsung,
                  building interactive retail experiences on a shared Java / Android SDK foundation.
                </p>
                <ul class="impact-list">
                  <li>Contributed to two flagship and three retail-demo applications showcased in Best Buy stores nationwide, with prominent apps using Java, XML, MVP architecture, and Dagger.</li>
                  <li>Built an S Pen drawing canvas for Galaxy devices and a music player with animated widgets for Samsung A-series devices, letting shoppers try drawing and audio experiences in stores.</li>
                  <li>Adopted React Native for Samsung A-series projects and explored Kotlin, Jetpack, and MVVM on a smaller device project. Collaborated with engineering and design on tailored interfaces and configured an HLS test server for media-playback experimentation.</li>
                </ul>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="skills" class="section">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">05 / Toolkit</p>
              <h2>What I bring to the build.</h2>
            </div>
          </div>

          <div class="capabilities">
            <article>
              <span class="capability-icon">01</span>
              <h3>Mobile</h3>
              <p>Kotlin, Java, Android SDK, React Native, Jetpack Compose, XML, native Android integrations</p>
            </article>
            <article>
              <span class="capability-icon">02</span>
              <h3>Architecture</h3>
              <p>Technical design, MVVM, MVP, dependency injection, offline-first synchronization, React Context API</p>
            </article>
            <article>
              <span class="capability-icon">03</span>
              <h3>Data & platform</h3>
              <p>REST API and GraphQL integration, Firebase, Crashlytics, Room, WorkManager, coroutines, WebView, HTML, CSS, JavaScript</p>
            </article>
            <article>
              <span class="capability-icon">04</span>
              <h3>Delivery</h3>
              <p>Code reviews, production troubleshooting, releases, cross-functional delivery, Git, Gradle, Jenkins, GitLab CI/CD</p>
            </article>
          </div>
        </div>
      </section>

      {recentArticles.length > 0 && (
        <section id="writing" class="section section--tinted home-writing" aria-labelledby="home-writing-title">
          <div class="container">
            <div class="section-heading">
              <div>
                <p class="eyebrow">06 / Writing</p>
                <h2 id="home-writing-title">Engineering notes.</h2>
              </div>
              <p>Android architecture, offline-first systems, and decisions behind reliable mobile software.</p>
            </div>
            <div class="home-writing__grid">
              {recentArticles.map((article) => <ArticleCard {article} />)}
            </div>
            <a class="text-link home-writing__all" href="/writing/">All writing <span aria-hidden="true">→</span></a>
          </div>
        </section>
      )}

      <section id="contact" class="contact-section">
        <div class="container contact-card">
          <div>
            <p class="eyebrow">{recentArticles.length > 0 ? '07' : '06'} / Contact</p>
            <h2>Let’s build something people can depend on.</h2>
          </div>
          <div class="contact-card__actions">
            <a class="btn btn--light" href="mailto:dannylpov@gmail.com">dannylpov@gmail.com <span aria-hidden="true">↗</span></a>
            <div class="social-links">
              <a href="https://github.com/DaCodaHUB" target="_blank" rel="noreferrer">GitHub</a>
              <a href="https://www.linkedin.com/in/dannyvle/" target="_blank" rel="noreferrer">LinkedIn</a>
              <a href="/assets/resume.pdf" target="_blank" rel="noreferrer">Résumé</a>
            </div>
          </div>
        </div>
      </section>
</BaseLayout>
