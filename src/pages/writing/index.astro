---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedArticles } from '../../lib/writing';

const articles = await getPublishedArticles();
---
<BaseLayout title="Writing — Dang Le" description="Notes on Android architecture, offline-first systems, and the engineering decisions behind reliable mobile software.">
  <section class="section writing-page" aria-labelledby="writing-title">
    <div class="container">
      <div class="writing-page__intro">
        <p class="eyebrow">Writing / Engineering notes</p>
        <h1 id="writing-title">Writing</h1>
        <p>Notes on Android architecture, offline-first systems, and the engineering decisions behind reliable mobile software.</p>
      </div>
      {articles.length > 0 ? (
        <div class="writing-list">
          {articles.map((article) => <ArticleCard {article} />)}
        </div>
      ) : (
        <div class="writing-empty">
          <p>No published notes yet. Explore the engineering case studies in the meantime.</p>
          <a class="text-link" href="/projects/">View projects <span aria-hidden="true">→</span></a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
