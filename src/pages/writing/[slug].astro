---
import { getEntry, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublishedArticles, readingMinutes } from '../../lib/writing';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props as { article: CollectionEntry<'writing'> };
const { Content } = await render(article);
const relatedProject = article.data.relatedProject ? await getEntry(article.data.relatedProject) : undefined;
if (article.data.relatedProject && !relatedProject) {
  throw new Error(`Related project ${article.data.relatedProject.id} was not found`);
}
if (!article.data.publishedAt) throw new Error(`Published article ${article.id} requires publishedAt`);
---
<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  publishedAt={article.data.publishedAt}
  updatedAt={article.data.updatedAt}
  tags={article.data.tags}
  readingMinutes={readingMinutes(article.body)}
  relatedProject={relatedProject && { id: relatedProject.id, title: relatedProject.data.title }}
>
  <Content />
</ArticleLayout>
