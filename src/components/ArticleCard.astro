---
import type { CollectionEntry } from 'astro:content';
import { formatArticleDate, readingMinutes } from '../lib/writing';

interface Props { article: CollectionEntry<'writing'>; }
const { article } = Astro.props;
const { title, description, publishedAt, updatedAt, tags } = article.data;
if (!publishedAt) throw new Error(`Published article ${article.id} requires publishedAt`);
const minutes = readingMinutes(article.body);
---
<article class="article-card">
  <div class="article-card__meta">
    <span>Published <time datetime={publishedAt.toISOString()}>{formatArticleDate(publishedAt)}</time></span>
    {updatedAt && <span>Updated <time datetime={updatedAt.toISOString()}>{formatArticleDate(updatedAt)}</time></span>}
    {minutes && <span>{minutes} min read</span>}
  </div>
  <h3><a href={`/writing/${article.id}/`}>{title}</a></h3>
  <p>{description}</p>
  {tags.length > 0 && <ul class="tags" aria-label="Article topics">{tags.map((tag) => <li>{tag}</li>)}</ul>}
  <a class="text-link" href={`/writing/${article.id}/`}>Read article <span aria-hidden="true">→</span></a>
</article>
