---
import raw from '../../public/data/engineering-demand/demand.json';
import type { DemandData } from '../../scripts/engineering-demand/types.ts';
import { openingsLabel, percentLabel, periodLabel, sourceStatus, topTechnologies } from '../lib/engineering-demand';
import '../styles/engineering-demand.css';
const data = raw as DemandData;
const growthValues = data.occupations.map(o => o.outlook.employmentGrowthPercent).filter((v): v is number => v !== null);
const low = Math.min(0, Math.floor(Math.min(...growthValues, 0) / 10) * 10);
const high = Math.max(10, Math.ceil(Math.max(...growthValues, 0) / 10) * 10);
const growthPosition = (v: number) => (v - low) / (high - low) * 100;
const openingsMax = Math.max(1, ...data.occupations.map(o => o.outlook.averageAnnualOpenings ?? 0));
const number = (value: number) => value.toLocaleString('en-US');
---
<section class="demand-explorer" id="engineering-demand" aria-labelledby="demand-title" data-demand-explorer>
  <div class="market-section-heading"><div><p class="eyebrow">Explore career paths</p><h2 id="demand-title">Engineering Demand Explorer</h2></div><a class="text-link" href="#demand-methodology">About the data ↓</a></div>
  <p class="market-muted">Technology mentions in job postings and long-term career outlook. Separate from Market Health.</p>
  <div class="market-controls demand-selector" data-demand-controls hidden>
    <label for="demand-occupation">Choose an occupation</label>
    <select id="demand-occupation" aria-controls="demand-occupation-panels">{data.occupations.map(o => <option value={o.id}>{o.name}</option>)}</select>
  </div>
  <p class="demand-sr-only" role="status" aria-live="polite" data-demand-selection-status></p>
  <noscript><p class="market-muted">JavaScript is disabled. All five occupations are shown below.</p></noscript>
  <div id="demand-occupation-panels">{data.occupations.map(occupation => {
    const technologies = occupation.technologies;
    const outlook = occupation.outlook;
    const year = technologies.source?.period.start.slice(0, 4);
    return <article class="market-panel demand-occupation" data-demand-occupation={occupation.id} data-occupation-name={occupation.name} aria-labelledby={`demand-${occupation.id}`}>
      <header class="demand-occupation-heading"><h3 id={`demand-${occupation.id}`}>{occupation.name}</h3><span>O*NET-SOC {occupation.onetSoc} · BLS {occupation.blsSoc}</span></header>
      <div class="demand-grid">
        <figure class="demand-technologies">
          <figcaption><h4>Top technology mentions</h4><p>{year ? `${year} U.S. job postings · Share mentioning each technology` : 'Posting data unavailable'}</p></figcaption>
          {technologies.status === 'available' ? <>
            <div class="demand-scale" aria-hidden="true"><span>0%</span><span>50%</span><span>100%</span></div>
            <ol class="demand-bars">{topTechnologies(data, occupation.id).map(skill => <li><div class="demand-bar-label"><span>{skill.name}</span><strong>{skill.mentionPercent}%</strong></div><div class="demand-track" aria-hidden="true"><span style={`width: ${skill.mentionPercent}%`} /></div></li>)}</ol>
          </> : <p class="demand-unavailable">{technologies.reason ?? 'Technology percentages are unavailable.'}</p>}
          {technologies.source && <p class="demand-source"><a href={technologies.source.url}>O*NET OnLine / Lightcast, {year}</a> · <a href={technologies.source.downloadUrl}>CSV</a></p>}
          <p class="market-muted">Percentages overlap. These are mentions, not openings or skill growth.</p>
        </figure>
        <div class="demand-outlook">
          <h4>Career outlook</h4><p class="market-muted">BLS projections · {periodLabel(outlook.source)}</p>
          <dl class="demand-outlook-metrics"><div><dt>Projected employment growth</dt><dd>{percentLabel(outlook.employmentGrowthPercent)}</dd><small>Total change over the projection period</small></div><div><dt>Average annual openings</dt><dd>{openingsLabel(outlook.averageAnnualOpenings)}</dd><small>Growth and occupational separations</small></div></dl>
          {outlook.reason && <p class="demand-unavailable">{outlook.reason}</p>}
          <p class="market-muted">Long-term projections do not measure current hiring.</p>
          <p class="demand-mapping-note">{occupation.caveat}</p>
          {outlook.source && <p class="demand-source"><a href={outlook.source.url}>BLS Table 1.2</a> · <a href={outlook.source.downloadUrl}>XLSX</a></p>}
        </div>
      </div>
      <div class="demand-freshness">{([['onet', technologies.source], ['bls', outlook.source]] as const).map(([kind, source]) => <p data-demand-freshness data-kind={kind} data-source={JSON.stringify(source)}><strong>{kind === 'onet' ? 'Posting data' : 'Projections'}:</strong> <span data-demand-freshness-label>{sourceStatus(source, kind)}</span>{source && <> · retrieved <time datetime={source.retrievedAt}>{source.retrievedAt.slice(0, 10)} UTC</time></>}{data.refresh[kind] === 'retained' && <strong> · Refresh failed; retained validated data.</strong>}</p>)}</div>
    </article>;
  })}</div>

  <figure class="market-panel demand-comparison" aria-labelledby="demand-comparison-title">
    <figcaption><h3 id="demand-comparison-title">Compare career outlooks</h3><p class="market-muted">BLS {periodLabel(data.occupations.find(o => o.outlook.source)?.outlook.source ?? null)} · Two separate scales; exact values beside every bar.</p></figcaption>
    <div class="demand-comparison-heading" aria-hidden="true"><span>Occupation</span><span>Employment growth ({low}% to {high}%)</span><span>Annual openings (0 to {number(openingsMax)})</span></div>
    <ul class="demand-comparison-list">{data.occupations.map(o => {
      const growth = o.outlook.employmentGrowthPercent, openings = o.outlook.averageAnnualOpenings;
      return <li data-demand-comparison={o.id}><strong class="demand-comparison-name">{o.name}</strong><div><span class="demand-comparison-value"><span>Growth</span> {percentLabel(growth)}</span><div class="demand-track demand-growth-track" aria-hidden="true"><i style={`left: ${growthPosition(0)}%`} />{growth !== null && <span style={`left: ${Math.min(growthPosition(0), growthPosition(growth))}%; width: ${Math.abs(growthPosition(growth) - growthPosition(0))}%`} />}</div></div><div><span class="demand-comparison-value"><span>Annual openings</span> {openingsLabel(openings)}</span><div class="demand-track demand-openings-track" aria-hidden="true">{openings !== null && <span style={`width: ${openings / openingsMax * 100}%`} />}</div></div></li>;
    })}</ul>
  </figure>

  <div class="market-details" id="demand-methodology">
    <div class="market-section-heading"><div><p class="eyebrow">Sources &amp; context</p><h3>How to read the explorer</h3></div><span class="market-method-version">{data.methodologyVersion}</span></div>
    <details class="market-panel market-disclosure"><summary>Definitions, periods &amp; limitations</summary>
      <p>{data.methodology.technologyDefinition}</p><p>{data.methodology.outlookDefinition}</p>
      <ul>{data.methodology.limitations.map(text => <li>{text}</li>)}</ul>
      <p>These are occupation-level views, not separate estimates for Android, backend, frontend, or other specialties. Faster projected growth and a larger number of openings answer different questions.</p>
      <p><a href="https://www.bls.gov/emp/documentation/definitions.htm">BLS definitions</a> · <a href="https://www.onetonline.org/help/online/browse_hot">O*NET technology methodology</a></p>
    </details>
    <details class="market-panel market-disclosure"><summary>Occupation mappings &amp; source provenance</summary>
      <p><a href={data.methodology.mappingUrl}>O*NET-SOC 2019 to 2018 SOC crosswalk</a>. Codes are explicitly mapped; shared prefixes alone are not used to infer equivalence.</p>
      <ul>{data.occupations.map(o => <li><strong>{o.name} ({o.onetSoc} → {o.blsSoc}):</strong> {o.caveat}</li>)}</ul>
      <p>The initial BLS snapshot is a reviewed extract of the official HTML Table 1.2, published August 27, 2026, because this development environment could not download the workbook. Later successful workbook refreshes replace that extract. Retrieval method and source hashes are recorded in the JSON.</p>
      <p>Refresh attempted <time datetime={data.refresh.attemptedAt}>{data.refresh.attemptedAt}</time>. O*NET: {data.refresh.onet}; BLS: {data.refresh.bls}.</p>
      {data.refresh.messages.map(message => <p>{message}</p>)}
      <p>Annual datasets do not become current hiring indicators after retrieval. A check is overdue after 35 days; an O*NET posting period is flagged after 550 days from its end, and a BLS base year after more than two calendar years. These are display review rules, not statistical validity thresholds.</p>
      <p>Freshness is recalculated in your browser using source timestamps; no economic APIs are contacted.</p>
    </details>
    <details class="market-panel market-disclosure"><summary>Attribution, transformations &amp; download</summary>
      <p>Includes information from <a href="https://www.onetonline.org/">O*NET OnLine</a> by USDOL/ETA, with employer-based posting aggregates attributed to <a href="https://lightcast.io/">Lightcast</a>. O*NET® is a trademark of USDOL/ETA. See <a href="https://www.onetonline.org/help/license">content license and exceptions</a> and <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. Raw Lightcast postings are not included.</p>
      <p>This portfolio normalizes and selects source data. USDOL/ETA has not approved, endorsed, or tested these modifications. <a href="https://www.bls.gov/bls/linksite.htm">BLS data is public domain</a>; attribution: U.S. Bureau of Labor Statistics, Employment Projections, Table 1.2.</p>
      <ul>{data.methodology.transformations.map(text => <li>{text}</li>)}</ul>
      <p>O*NET database software-skill flags do not supply posting percentages and are not substituted for employer-based percentages.</p>
      <a class="text-link" href="/data/engineering-demand/demand.json">Download explorer JSON ↓</a>
    </details>
  </div>
</section>
<script>
  import { selectOccupation, sourceStatus } from '../lib/engineering-demand';
  import type { SourceMetadata } from '../../scripts/engineering-demand/types.ts';
  const root = document.querySelector<HTMLElement>('[data-demand-explorer]');
  if (root) {
    const selector = root.querySelector<HTMLSelectElement>('#demand-occupation');
    if (selector && selectOccupation(root, selector.value)) {
      const controls = root.querySelector<HTMLElement>('[data-demand-controls]');
      if (controls) controls.hidden = false;
      selector.addEventListener('change', () => selectOccupation(root, selector.value));
    }
    const updateFreshness = () => root.querySelectorAll<HTMLElement>('[data-demand-freshness]').forEach(row => {
      const label = row.querySelector('[data-demand-freshness-label]');
      if (label) label.textContent = sourceStatus(JSON.parse(row.dataset.source ?? 'null') as SourceMetadata | null, row.dataset.kind as 'onet' | 'bls');
    });
    updateFreshness(); window.setInterval(updateFreshness, 60_000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) updateFreshness(); });
  }
</script>
