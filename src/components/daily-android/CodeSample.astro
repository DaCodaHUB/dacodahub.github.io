---
import type { CodeSample } from '../../data/android-challenges/types';
interface Props { sample: CodeSample }
const { sample } = Astro.props;
---
<div class="daily-code">
  <p class="daily-code-context">{sample.context}</p>
  <pre tabindex="0" aria-label={`${sample.language === 'kotlin' ? 'Kotlin' : 'Pseudocode'} example`}><code>{sample.code}</code></pre>
  <p class="daily-code-note">{sample.language === 'pseudocode' ? 'Pseudocode' : 'Kotlin example'} · Not compiler-tested. Dependencies: {sample.dependencies.join('; ')}.</p>
</div>
