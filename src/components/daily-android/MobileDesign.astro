---
import { designChallenges } from '../../data/mobile-system-design/challenges';
import '../../styles/mobile-design.css';
import DesignDiagram from './DesignDiagram.astro';
import DesignText from './DesignText.astro';
import PromptText from './PromptText.astro';
import { designPresentation, sentences } from '../../data/mobile-system-design/presentation';
import { validateDesignChallenges } from '../../lib/daily-android/mobile-design';
const errors = validateDesignChallenges(designChallenges);
if (errors.length) throw Error(errors.join('\n'));
const questionSections = [
  ['scenario', 'Scenario', '◎'], ['functional', 'Functional requirements', '✓'],
  ['nonFunctional', 'Non-functional requirements', '◷'], ['assumptions', 'Given assumptions', '≡'],
  ['tasks', 'Design tasks', '↗'], ['outOfScope', 'Out of scope', '−'],
] as const;
// Exact excerpts: these are a quick index, with all qualifications retained below.
const metricExcerpts: Record<string, string[]> = {
  'msd-001': ['up to 5,000 notes per account', '10 KB per note', 'cached list visible within 300 ms'],
  'msd-002': ['pages of 20 posts', 'cache at most 1,000 posts per account', 'cached first content within 300 ms'],
  'msd-003': ['access tokens last five minutes', 'refresh sessions last 30 days unless revoked'],
  'msd-004': ['each photo is at most 20 MB', 'account pending data is capped at 500 MB', 'chunks are 1 MB'],
  'msd-005': ['100 conversations per account', '10,000 cached messages', 'text up to 4 KB'],
  'msd-006': ['at most 100 assignment events per account per day', 'Deduplicate task-event notifications for seven days.'],
  'msd-007': ['scan for at most 15 seconds per explicit action', 'retain at most 24 hours of readings sampled once per minute', 'mark data stale after five seconds without a reading.'],
  'msd-008': ['at most five devices and 20 supported scalar settings per account', 'offline periods last up to 30 days'],
};
const solutionSections = [
  { title: 'Architecture', icon: '◇', tone: 'logic', keys: ['architecture'] },
  { title: 'Components and responsibilities', icon: '▦', tone: 'logic', keys: ['components', 'contracts'] },
  { title: 'Data flow', icon: '⇄', tone: 'work', keys: ['workflows'] },
  { title: 'Key design decisions', icon: '✓', tone: 'storage', keys: ['technologies'] },
  { title: 'Failure handling and edge cases', icon: '!', tone: 'risk', keys: ['recovery'] },
  { title: 'Tradeoffs and alternatives', icon: '⇆', tone: 'work', keys: ['tradeoffs'] },
  { title: 'Testing strategy', icon: '◎', tone: 'ui', keys: ['testing'] },
  { title: 'Interview talking points', icon: '↗', tone: 'logic', keys: ['talkingPoints'] },
] as const;
---
<div data-mobile-design>
  <div data-md-slot></div>
  {designChallenges.map(challenge => <template data-md-template={challenge.id}>
    <article class="daily-card daily-engineering" data-md-challenge={challenge.id}>
      <div class="daily-card-heading"><p class="eyebrow">Mobile System Design</p><span class="daily-tag">{challenge.difficulty} · {challenge.minutes} minutes</span></div>
      <h2 tabindex="-1">{challenge.title}</h2>
      <p class="daily-hint">{challenge.topic}</p>
      <p class="daily-hint" data-md-position></p>
      <p class="daily-hint">All scale and timing numbers are invented interview assumptions, not measurements or Android guarantees. Use the given contract; no interviewer clarification is needed.</p>
      <div class="md-prompt">
        {questionSections.map(([key, title, icon]) => <section class={`md-prompt-section md-prompt-${key}`} aria-labelledby={`${challenge.id}-${key}`}>
          <h3 id={`${challenge.id}-${key}`}><span aria-hidden="true">{icon}</span>{title}</h3>
          {key === 'nonFunctional' && <ul class="md-prompt-metrics" aria-label="Selected interview constraints">{metricExcerpts[challenge.id]!.map(text => <li><PromptText text={text} /></li>)}</ul>}
          {key === 'scenario'
            ? challenge.question[key].map(line => <p><PromptText text={line} /></p>)
            : key === 'tasks'
              ? <ol class="md-prompt-tasks">{challenge.question[key].map(line => <li><PromptText text={line} /></li>)}</ol>
              : <ul class="md-prompt-list">{challenge.question[key].map(line => <li><PromptText text={line} /></li>)}</ul>}
        </section>)}
      </div>
      <section aria-labelledby={`practice-${challenge.id}`}>
        <h3 id={`practice-${challenge.id}`}>Practice Your Solution</h3>
        <ul class="daily-resource-list" data-md-practice>
          <li><a href="https://app.coderpad.io/sandbox" target="_blank" rel="noopener noreferrer">Code in CoderPad<span class="sr-only"> (opens in a new tab)</span></a><p>Practice Kotlin implementations and small code examples.</p></li>
          <li><a href="https://excalidraw.com/" target="_blank" rel="noopener noreferrer">Draw in Excalidraw<span class="sr-only"> (opens in a new tab)</span></a><p>Sketch system architecture, component relationships, and data flows.</p></li>
        </ul>
      </section>
      <button type="button" class="btn" aria-expanded="false" aria-controls={`reference-${challenge.id}`} data-md-reveal>Reveal Reference Design</button>
      <section id={`reference-${challenge.id}`} class="daily-answer mobile-design-reference" data-md-reference hidden aria-label="Reference design">
        <p class="daily-hint">One practical design, not a single correct answer. Mandatory behavior comes from the requirements; library and architecture choices can vary if you justify them.</p>
        {solutionSections.map(({ title, icon, tone, keys }) => <section class={`md-section md-color-${tone}`}>
          <h3><span class="md-section-icon" aria-hidden="true">{icon}</span>{title}</h3>
          {title === 'Architecture' && <DesignDiagram id={challenge.id} />}
          {title === 'Key design decisions' && <dl class="md-decisions">
            <div><dt>Recommended</dt><dd>{designPresentation[challenge.id]!.recommendation}</dd></div>
            <div><dt>Why</dt><dd>{designPresentation[challenge.id]!.why}</dd></div>
            <div><dt>Alternative</dt><dd>{designPresentation[challenge.id]!.alternative}</dd></div>
            <div class="md-decision-risk"><dt>Watch for</dt><dd>{designPresentation[challenge.id]!.risk}</dd></div>
          </dl>}
          {keys.map(key => <div class:list={{ 'md-contracts': key === 'contracts' }}>
            {key === 'contracts' && <h4>Data models and API contracts</h4>}
            {key === 'workflows'
              ? challenge.solution[key].map(line => /^1\. /.test(line)
                ? <ol class="md-workflow">{line.split(/(?:^|\s)\d+\. /).filter(Boolean).map(step => <li><DesignText text={step} /></li>)}</ol>
                : <p><DesignText text={line} /></p>)
              : <ul class="md-prose">{challenge.solution[key].flatMap(line => sentences(line)).map(line => <li><DesignText text={line} /></li>)}</ul>}
          </div>)}
        </section>)}
        <h3>References</h3>
        <ul class="daily-resource-list">{challenge.references.map(ref => <li><a href={ref.url} target="_blank" rel="noopener noreferrer">{ref.title}<span class="sr-only"> (opens in a new tab)</span></a></li>)}</ul>
        <button type="button" class="btn" data-md-hide>Hide Reference Design</button>
      </section>
      <div class="daily-actions"><button type="button" class="btn" data-md-complete>Completed</button><button type="button" class="btn" data-md-review>Needs Review</button></div>
      <p class="daily-progress" role="status" aria-live="polite" data-md-status></p>
      <div class="daily-actions"><button type="button" class="btn" data-md-previous>Previous</button><button type="button" class="btn" data-md-next>Next</button><button type="button" class="btn" data-md-recommended>Recommended challenge</button></div>
      <p class="daily-hint" data-md-recommendation></p>
      <label for={`select-${challenge.id}`}>Revisit or practice any design</label>
      <select id={`select-${challenge.id}`} data-md-select>{designChallenges.map(c => <option value={c.id}>{c.title}</option>)}</select>
      <p class="daily-progress" data-md-progress></p>
      <p class="daily-hint">Practice as often as you like. Recommendations follow the learning order, including Needs Review. Dates never advance or reset your design progress.</p>
    </article>
  </template>)}
  <p class="daily-storage" role="status" data-md-storage>Design progress is saved separately in this browser. Clearing browser data removes them.</p>
</div>
