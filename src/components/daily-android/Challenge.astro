---
import type { ReviewChallenge } from '../../data/android-challenges/review-types';
import InlineCode from './InlineCode.astro';
import CodeSample from './CodeSample.astro';
interface Props { challenge: ReviewChallenge }
const { challenge: c } = Astro.props;
---
<article class="daily-card daily-engineering" data-challenge={c.id} data-challenge-type={c.type} data-difficulty={c.difficulty} aria-labelledby={`${c.id}-title`}>
  <div class="daily-card-heading"><p class="eyebrow">02 / Android code review</p><span class="daily-tag">{c.difficulty}</span></div>
  <div class="daily-challenge-meta"><span>{c.topic}</span><span>About {c.estimatedMinutes} min</span></div>
  <h2 id={`${c.id}-title`}>{c.title}</h2>
  <CodeSample sample={c.snippet} />
  <h3>Review task</h3><p><InlineCode text={c.prompt} /></p>
  <div class="daily-response">
    <label for={`${c.id}-response`}>Your response <span>(optional)</span></label>
    <p id={`${c.id}-response-help`}>Identify the issues, their impact, and a safe correction. Your answer is not automatically graded.</p>
    <textarea id={`${c.id}-response`} data-response rows="7" maxlength="20000" aria-describedby={`${c.id}-response-help`} placeholder="Write your review…"></textarea>
    <label class="daily-save-choice"><input type="checkbox" data-save-response /> Save my response on this device</label>
    <p class="daily-progress" data-response-status role="status">Your response is not saved unless you choose to save it.</p>
  </div>
  <details class="daily-reveal" data-challenge-solution>
    <summary>Reveal Findings</summary>
    <div class="daily-answer">
      <h3>Expected findings</h3>
      <ul>{c.issues.map(issue => <li><strong>{issue.location}</strong><p><InlineCode text={issue.rootCause} /></p><p><strong>Impact:</strong> <InlineCode text={issue.consequence} /></p><p><strong>Suggested fix:</strong> <InlineCode text={issue.fix} /></p></li>)}</ul>
      <h3>One possible correction</h3><CodeSample sample={c.correctedImplementation} />
      <h3>Engineering tradeoffs</h3><p><InlineCode text={c.tradeoffs} /></p>
      <details class="daily-flashcard-extra"><summary>Follow-up questions</summary><ul>{c.followUps.map(item => <li>{item}</li>)}</ul></details>
      <h3>Supporting documentation</h3><ul class="daily-resource-list">{c.references.map(ref => <li><a href={ref.url} target="_blank" rel="noopener noreferrer">{ref.title}<span class="sr-only"> (opens in a new tab)</span></a><p>{ref.supports}</p></li>)}</ul>
      <p>Self-evaluation: compare your findings, proposed correction, and tradeoffs with this reference.</p>
      <div class="daily-actions"><button class="btn btn--primary" type="button" data-complete-challenge>Mark challenge complete</button><button class="btn" type="button" data-review-challenge aria-pressed="false">Needs review</button></div>
    </div>
  </details>
  <p class="daily-progress" data-challenge-progress role="status">Not completed on this device.</p>
  <div class="daily-response">
    <label for={`${c.id}-difficulty`}>Practice difficulty</label>
    <select id={`${c.id}-difficulty`} data-review-difficulty aria-label="Practice difficulty"><option value="all">All difficulties</option><option>Easy</option><option>Medium</option><option>Hard</option></select>
    <div class="daily-actions"><button class="btn" type="button" data-next-challenge>Practice a random challenge</button></div>
    <p class="daily-progress" data-challenge-session role="status">Today’s recommendation. Practice as often as you like.</p>
  </div>
</article>
