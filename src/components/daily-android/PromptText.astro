---
const { text } = Astro.props as { text: string };
// Tokenize without rewriting the brief or injecting HTML.
const pattern = /(\b\d[\d,]*(?:\.\d+)?(?:\+)?(?:\s(?:KB|MB|ms|seconds?|minutes?|hours?|days?|posts|notes|photos|conversations|messages|settings|devices))?\b|\b(?:one|two|five|seven|30) (?:seconds?|minutes?|hours?|days?)\b|\b(?:process death|source of truth|Offline|offline|HTTPS|TLS|PKCE|OAuth|OIDC|idempotent|tombstones?|operationId|baseRevision|nextCursor|snapshotId|main thread|server-confirmed|authorization)\b)/g;
const parts = text.split(pattern);
---
{parts.map((part, index) => index % 2 ? <strong>{part}</strong> : part)}
