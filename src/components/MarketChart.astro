---
import type { Assessment } from '../../scripts/job-market/health-types.ts';
import { chartPath, scoreFor, formatScore, formatDate, seriesLabels } from '../lib/market';
import type { ChartSeries } from '../lib/market';
interface Props { history: Assessment[] }
const { history } = Astro.props;
const series: ChartSeries[] = ['overall', 'demand', 'employment'];
const last = history.at(-1);
---
<section class="market-panel market-chart" aria-labelledby="history-title" data-market-chart>
  <div class="market-section-heading">
    <div><p class="eyebrow">Through time</p><h2 id="history-title">Market history</h2></div>
    <div class="market-controls" data-chart-controls hidden>
      <label for="chart-series">View series</label>
      <select id="chart-series">
        {series.map(key => <option value={key}>{seriesLabels[key]}</option>)}
      </select>
    </div>
  </div>
  <p class="market-muted">Monthly scores, 0–100. Gaps mean unavailable data. Component scores describe one signal, not the overall market.</p>
  {series.map(key => <div data-chart-series={key} hidden={key !== 'overall'}>
    <p class="market-chart-note">{history.some(row => scoreFor(row, key) !== null)
      ? `${seriesLabels[key]} scores from the generated assessment. Select a month below to inspect its value.`
      : `No ${seriesLabels[key].toLowerCase()} scores are available. No line is drawn.`}</p>
    <div class="market-chart-scroll" tabindex="0" role="region" aria-label={`${seriesLabels[key]} chart; scroll horizontally on small screens`}>
      <svg viewBox="0 0 900 265" role="img" aria-labelledby={`chart-title-${key} chart-desc-${key}`}>
        <title id={`chart-title-${key}`}>{seriesLabels[key]} history</title>
        <desc id={`chart-desc-${key}`}>Scores from 0 to 100, higher indicating stronger conditions. Full values and missing-data states are in the table below. Missing observations are not connected.</desc>
        {[0, 40, 60, 100].map(value => <g>
          <line x1="48" x2="848" y1={220 - value * 1.8} y2={220 - value * 1.8} stroke="currentColor" stroke-opacity="0.15" stroke-dasharray={value === 40 || value === 60 ? '4 6' : undefined} />
          <text x="34" y={225 - value * 1.8} text-anchor="end" fill="currentColor">{value}</text>
        </g>)}
        <text x="48" y="253" fill="currentColor">{formatDate(history[0]?.referenceMonth ?? null, true)}</text>
        <text x="848" y="253" text-anchor="end" fill="currentColor">{formatDate(last?.referenceMonth ?? null, true)}</text>
        <path d={chartPath(history, key)} fill="none" stroke={key === 'employment' ? 'var(--accent-blue)' : 'var(--accent)'} stroke-width="3" stroke-linejoin="round" />
        {history.map((row, index) => {
          const score = scoreFor(row, key);
          return score !== null && <circle cx={48 + index / Math.max(1, history.length - 1) * 800} cy={220 - score * 1.8} r="2.5" fill={key === 'employment' ? 'var(--accent-blue)' : 'var(--accent)'}><title>{formatDate(row.referenceMonth, true)}: {formatScore(score)}</title></circle>;
        })}
        <line data-chart-cursor x1="848" x2="848" y1="35" y2="220" stroke="var(--ink)" stroke-opacity="0.5" visibility="hidden" />
      </svg>
    </div>
  </div>)}
  {history.length > 0 && <div class="market-month-picker" data-chart-controls hidden>
    <label for="chart-month">Inspect reference month <span class="market-muted">· use arrow keys to move</span></label>
    <input id="chart-month" type="range" min="0" max={history.length - 1} value={history.length - 1} aria-describedby="chart-readout" />
    <output id="chart-readout" for="chart-month chart-series" aria-live="polite"></output>
  </div>}
  <noscript><p>Interactive controls require JavaScript. Every historical value and component is available in the table below.</p></noscript>
  <details class="market-history-table">
    <summary>Read all historical values</summary>
    <div class="market-table-scroll" tabindex="0" role="region" aria-label="Monthly market history table">
      <table>
        <caption>Retrospective monthly assessments. Unavailable values are not zero. Component scores are separate from the overall classification.</caption>
        <thead><tr><th scope="col">Reference month</th><th scope="col">Overall / 100</th><th scope="col">Classification</th><th scope="col">Demand / 100</th><th scope="col">Employment / 100</th></tr></thead>
        <tbody>{history.map(row => <tr data-history-row data-month={row.referenceMonth} data-overall={scoreFor(row, 'overall') ?? ''} data-demand={scoreFor(row, 'demand') ?? ''} data-employment={scoreFor(row, 'employment') ?? ''} data-classification={row.classification}>
          <th scope="row">{formatDate(row.referenceMonth, true)}</th><td>{formatScore(scoreFor(row, 'overall'))}</td><td>{row.classification}</td><td>{formatScore(scoreFor(row, 'demand'))}</td><td>{formatScore(scoreFor(row, 'employment'))}</td>
        </tr>)}</tbody>
      </table>
    </div>
  </details>
</section>

<script>
  import { formatDate } from '../lib/market';
  import type { ChartSeries } from '../lib/market';
  document.querySelectorAll<HTMLElement>('[data-market-chart]').forEach(chart => {
    const select = chart.querySelector<HTMLSelectElement>('select')!;
    const slider = chart.querySelector<HTMLInputElement>('input[type="range"]');
    const output = chart.querySelector<HTMLOutputElement>('output');
    const rows = [...chart.querySelectorAll<HTMLElement>('[data-history-row]')];
    function update() {
      const key = select.value as ChartSeries;
      const index = Number(slider?.value ?? 0);
      chart.querySelectorAll<HTMLElement>('[data-chart-series]').forEach(group => { group.hidden = group.dataset.chartSeries !== key; });
      const row = rows[index];
      if (!row || !output) return;
      const raw = row.dataset[key];
      const value = raw === '' || raw === undefined ? 'Unavailable' : Number(raw).toFixed(1) + ' / 100';
      const label = `${formatDate(row.dataset.month ?? null, true)} · ${select.selectedOptions[0]!.textContent}: ${value}${key === 'overall' ? ' · ' + row.dataset.classification : ' · Component only'}`;
      output.textContent = label;
      slider?.setAttribute('aria-valuetext', label);
      const x = String(48 + index / Math.max(1, rows.length - 1) * 800);
      chart.querySelectorAll<SVGLineElement>('[data-chart-cursor]').forEach(line => { line.setAttribute('visibility', 'visible'); line.setAttribute('x1', x); line.setAttribute('x2', x); });
    }
    chart.querySelectorAll<HTMLElement>('[data-chart-controls]').forEach(control => { control.hidden = false; });
    select.addEventListener('change', update);
    slider?.addEventListener('input', update);
    chart.querySelectorAll<SVGSVGElement>('svg').forEach(svg => {
      svg.addEventListener('pointerdown', event => {
        if (!slider || !rows.length) return;
        const bounds = svg.getBoundingClientRect();
        const fraction = ((event.clientX - bounds.left) / bounds.width * 900 - 48) / 800;
        slider.value = String(Math.round(Math.max(0, Math.min(1, fraction)) * (rows.length - 1)));
        update();
      });
    });
    update();
  });
</script>
